    "def f(x):\n",
    "    f = x**2 - 6*x + 13\n",
    "    return f\n",
    "def difff(x):\n",
    "    f = 2*x - 6\n",
    "    return f\n",
    "\n",
    "xn = 0.0\n",
    "a = 0.1\n",
    "history = []\n",
    "for i in range (20):\n",
    "        history.append(xn)\n",
    "        newx = xn - a*difff(xn)\n",
    "        xn = newx\n",
    "        \n",
    "\n",
    "print(xn)\n",
    "for i in history:\n",
    "    print(i)"
   ]
